---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'GYK Studio — Portfolio | Diseño y Desarrollo Web',
  description = 'Portfolio oficial de gykstudio: proyectos, servicios de diseño y desarrollo web, y contacto. / Official gykstudio portfolio: projects, web design & development services, and contact.',
} = Astro.props;

import '../styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
